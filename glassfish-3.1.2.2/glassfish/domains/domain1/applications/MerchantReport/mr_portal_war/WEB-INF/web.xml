 <security-constraint>
    <display-name>HTTPS-redirect</display-name>
    <web-resource-collection>
        <web-resource-name>secured-environments</web-resource-name>
        <description>Do HTTPS redirect so that the connection is secured</description>
        <url-pattern>/index.html</url-pattern>
        <url-pattern>/login.html</url-pattern>
    </web-resource-collection>
     <auth-constraint>
            <role-name>merchant</role-name>
            <role-name>admin</role-name>
            <role-name>commercial</role-name>
            <role-name>masterdata_admin</role-name>
            <role-name>finance</role-name>
        </auth-constraint>
    <user-data-constraint>
        <transport-guarantee>CONFIDENTIAL</transport-guarantee>
    </user-data-constraint>
</security-constraint>   
    
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>MerchantLoginRealm</realm-name>
        <form-login-config>
            <form-login-page>/login.html</form-login-page>
            <form-error-page>/loginError.html</form-error-page>
        </form-login-config>
    </login-config>
    <security-role>
        <role-name>merchant</role-name>
    </security-role>
    <security-role>
        <role-name>admin</role-name>
    </security-role>
    <security-role>
        <role-name>commercial</role-name>
    </security-role>
    <security-role>
        <role-name>finance</role-name>
    </security-role>
    <security-role>
        <role-name>masterdata_admin</role-name>
    </security-role>
