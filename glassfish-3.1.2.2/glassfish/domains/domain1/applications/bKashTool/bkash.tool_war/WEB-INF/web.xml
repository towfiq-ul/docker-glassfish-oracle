<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>ADMIN PERMISIONS</web-resource-name>
            <url-pattern>/index.html</url-pattern>
            <url-pattern>/login.html</url-pattern>
            <http-method>GET</http-method>
            <http-method>POST</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>user</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>bKashToolRealm</realm-name>
        <form-login-config>
            <form-login-page>/login.html</form-login-page>
            <form-error-page>/loginError.html</form-error-page>
        </form-login-config>
    </login-config>
    <security-role>
        <role-name>user</role-name>
    </security-role>
    <ejb-local-ref>
        <ejb-ref-name>RefundFileGenerationBean</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.bkash.rnd.refund.eft.ejb.bean.RefundFileGenerationBeanLocal</local>
        <ejb-link>bKashTool-ejb.jar#RefundFileGenerationBean</ejb-link>
    </ejb-local-ref>
    <ejb-local-ref>
        <ejb-ref-name>RefundFileGenerationBean1</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.bkash.rnd.refund.eft.ejb.bean.RefundFileGenerationBeanLocal</local>
        <ejb-link>bKashTool-ejb.jar#RefundFileGenerationBean</ejb-link>
    </ejb-local-ref>
    <ejb-local-ref>
        <ejb-ref-name>ReportBean</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.bkash.rnd.refund.eft.ejb.bean.ReportBeanLocal</local>
        <ejb-link>bKashTool-ejb.jar#ReportBean</ejb-link>
    </ejb-local-ref>
</web-app>
