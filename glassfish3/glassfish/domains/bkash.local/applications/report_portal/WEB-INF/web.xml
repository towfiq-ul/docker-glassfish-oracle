<!--    <listener>
        <listener-class>com.bkash.web.listener.EventListener</listener-class>
    </listener>-->
    <!-- Defining the error pages -->
    <error-page>
        <error-code>403</error-code>
        <location>/secure/403.jsp</location>
    </error-page>
<!--    <error-page>
        <error-code>404</error-code>
        <location>/secure/404.jsp</location>
    </error-page>-->
    <error-page>
        <error-code>500</error-code>
        <location>/secure/500.jsp</location>
    </error-page>
    <!-- Specifying Security Constraints for Resources-->
    <!--ADMIN PROTECTED -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Admin protected area</web-resource-name>
            <url-pattern>/secure/Admin/*</url-pattern>
            <url-pattern>/services/auth/register</url-pattern>
            <url-pattern>/services/auth/remove</url-pattern>
            <url-pattern>/services/auth/list</url-pattern>
            <url-pattern>/services/auth/reset</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMINISTRATOR</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <!-- ACTIONS -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>All the Actions</web-resource-name>
            <url-pattern>/secure/action/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>SND</role-name>
            <role-name>ADMINISTRATOR</role-name>
            <role-name>DISTRIBUTOR</role-name>
            <role-name>BSA</role-name>
            <role-name>AGENT</role-name>
            <role-name>COMPLIANCE</role-name>
            <role-name>QC</role-name>
            <role-name>SalesOps</role-name>
            <role-name>RSM</role-name>
            <role-name>SM</role-name>
            <role-name>TM</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <!--USER CONFIG BY ADMIN -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>User Configuration</web-resource-name>
            <url-pattern>/secure/action/user_config/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMINISTRATOR</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <!-- SECURED CONTENT -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Secured Content</web-resource-name>
            <url-pattern>/secure/*</url-pattern>
            <url-pattern>/services/secure/*</url-pattern>
            <url-pattern>/secure/action/home</url-pattern>
            <url-pattern>/secure/action/dashboard</url-pattern>
        </web-resource-collection>
        <web-resource-collection>
            <web-resource-name>pass_chng</web-resource-name>
            <url-pattern>/services/auth/change</url-pattern>
            <url-pattern>/secure/action/change</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMINISTRATOR</role-name>
            <role-name>SND</role-name>
            <role-name>DISTRIBUTOR</role-name>
            <role-name>BSA</role-name>
            <role-name>AGENT</role-name>
            <role-name>COMPLIANCE</role-name>
            <role-name>QC</role-name>
            <role-name>SalesOps</role-name>
            <role-name>RSM</role-name>
            <role-name>SM</role-name>
            <role-name>TM</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <!-- declare the roles relevant for our webapp -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    <security-role>
        <role-name>ADMINISTRATOR</role-name>
    </security-role>
    <security-role>
        <role-name>DISTRIBUTOR</role-name>
    </security-role>
    <security-role>
        <role-name>BSA</role-name>
    </security-role>
    <security-role>
        <role-name>AGENT</role-name>
    </security-role>
    <security-role>
        <role-name>SND</role-name>
    </security-role>
    <!-- Resources declaration -->
    <security-role>
        <description/>
        <role-name>COMPLIANCE</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>QC</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>SalesOps</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>RSM</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>SM</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>TM</role-name>
    </security-role>
    <resource-ref>
        <res-ref-name>jdbc/rgportal_prod_res</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>
</web-app>
