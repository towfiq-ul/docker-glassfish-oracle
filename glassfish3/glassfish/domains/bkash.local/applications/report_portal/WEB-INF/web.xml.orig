<?xml version="1.0" encoding="UTF-8"?>
<web-app id="WebApp_ID" version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">
    <display-name>Authentication</display-name>
    <welcome-file-list>
        <welcome-file>welcome.jsp</welcome-file>
    </welcome-file-list>
    <!-- Jersey REST -->
    <servlet>
        <servlet-name>ServletAdaptor</servlet-name>
        <servlet-class>com.sun.jersey.spi.container.servlet.ServletContainer</servlet-class>
        <!-- this would allow us to get rid of @XmlRootElement -->
        <!-- but since we use jersey-json we don't need this -->
        <!-- 
    <init-param>      
      <param-name>com.sun.jersey.api.json.POJOMappingFeature</param-name>
      <param-value>true</param-value>
    </init-param>
     -->
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletAdaptor</servlet-name>
        <url-pattern>/services/*</url-pattern>
    </servlet-mapping>
    <error-page>
        <error-code>403</error-code>
        <location>/secure/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/secure/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/secure/500.jsp</location>
    </error-page>
    <security-constraint>
        <display-name>Admin</display-name>
        <web-resource-collection>
            <web-resource-name>Admin</web-resource-name>
            <description/>
            <url-pattern>/secure/Admin/*</url-pattern>
            <url-pattern>/services/auth/register</url-pattern>
            <url-pattern>/services/auth/remove</url-pattern>
            <url-pattern>/services/auth/list</url-pattern>
            <url-pattern>/services/auth/reset</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>ADMINISTRATOR</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Action</display-name>
        <web-resource-collection>
            <web-resource-name>Action</web-resource-name>
            <description/>
            <url-pattern>/secure/action/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>QC</role-name>
            <role-name>DISTRIBUTOR</role-name>
            <role-name>SND</role-name>
            <role-name>FINANCE</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Action_qc</display-name>
        <web-resource-collection>
            <web-resource-name>Action_qc</web-resource-name>
            <description/>
            <url-pattern>/secure/action/qc/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>QC</role-name>
            <role-name>SND</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Action_dist</display-name>
        <web-resource-collection>
            <web-resource-name>Action_dist</web-resource-name>
            <description/>
            <url-pattern>/secure/action/dist/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>DISTRIBUTOR</role-name>
            <role-name>SND</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Upload_bso</display-name>
        <web-resource-collection>
            <web-resource-name>Upload</web-resource-name>
            <description/>
            <url-pattern>/secure/upload/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>BSO</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Stat_Actions</display-name>
        <web-resource-collection>
            <web-resource-name>Stat_Actions</web-resource-name>
            <description/>
            <url-pattern>/secure/action/qc_snd/result_tab.jsp</url-pattern>
            <url-pattern>/secure/action/upload_data</url-pattern>
            <url-pattern>/secure/action/upload_stat</url-pattern>
            <url-pattern>/secure/action/files.jsp</url-pattern>
            <url-pattern>/secure/action/audit_data</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>SND</role-name>
            <role-name>QC</role-name>
            <role-name>BSO</role-name>
            <role-name>FINANCE</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Upload_qc</display-name>
        <web-resource-collection>
            <web-resource-name>Upload_qc</web-resource-name>
            <description/>
            <url-pattern>/secure/upload_qc/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>QC</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Upload_snd</display-name>
        <web-resource-collection>
            <web-resource-name>Upload_snd</web-resource-name>
            <description/>
            <url-pattern>/secure/upload_snd/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>SND</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Action_fin</display-name>
        <web-resource-collection>
            <web-resource-name>finance</web-resource-name>
            <description/>
            <url-pattern>/secure/action/fin/*</url-pattern>
            <url-pattern>/secure/upload_fin/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>FINANCE</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>wallet</display-name>
        <web-resource-collection>
            <web-resource-name>wallet</web-resource-name>
            <description/>
            <url-pattern>/secure/action/search_wallet</url-pattern>
            <url-pattern>/secure/action/wallet_search_1.jsp</url-pattern>
            <url-pattern>/secure/action/entry_wallet</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>FINANCE</role-name>
            <role-name>QC</role-name>
            <role-name>SND</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>BARCODE</display-name>
        <web-resource-collection>
            <web-resource-name>barcode</web-resource-name>
            <description/>
            <url-pattern>/secure/action/update_auth.jsp</url-pattern>
            <url-pattern>/secure/action/index.jsp</url-pattern>
            <url-pattern>/secure/action/check</url-pattern>
            <url-pattern>/secure/action/update</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>QC</role-name>
            <role-name>DISTRIBUTOR</role-name>
            <role-name>SND</role-name>
        </auth-constraint>
        <user-data-constraint>
            <description/>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>chromiaUsers</realm-name>
        <form-login-config>
            <form-login-page>/WEB-INF/login.jsp</form-login-page>
            <form-error-page>/WEB-INF/loginError.html</form-error-page>
        </form-login-config>
    </login-config>
    <!-- 
  you could also define a page that is displayed if
  glassfish determins that an authenticated user is not
  authorized to access a resource
  <error-page>
    <error-code>403</error-code>
    <location>/not-authorized.html</location>
  </error-page>
  -->
    <security-constraint>
        <!-- everything below /secure/* and /services/secure/* requires authentication -->
        <web-resource-collection>
            <web-resource-name>Secured Content</web-resource-name>
            <description/>
            <url-pattern>/secure/*</url-pattern>
            <url-pattern>/services/secure/*</url-pattern>
            <url-pattern>/secure/action/home</url-pattern>
        </web-resource-collection>
        <!-- only users with at least one of these roles are allowed to access the secured content -->
        <web-resource-collection>
            <web-resource-name>pass_chng</web-resource-name>
            <description/>
            <url-pattern>/services/auth/change</url-pattern>
            <url-pattern>/secure/action/change</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMINISTRATOR</role-name>
            <role-name>DISTRIBUTOR</role-name>
            <role-name>QC</role-name>
            <role-name>BSO</role-name>
            <role-name>SND</role-name>
            <role-name>CS</role-name>
            <role-name>FINANCE</role-name>
        </auth-constraint>
        <!-- we always want https! -->
        <user-data-constraint>
            <description>highest supported transport security level</description>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>
    <!-- declare the roles relevant for our webapp -->
    <security-role>
        <role-name>ADMINISTRATOR</role-name>
    </security-role>
    <session-config>
        <!-- on productive systems you might have another value for the timeout -->
        <session-timeout>15</session-timeout>
        <!-- 
       we don't want to use the default name JSESSIONID because this 
       tells everyone (especially hackers) that our application is based on java 
    -->
    </session-config>
    <security-role>
        <description/>
        <role-name>QC</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>DISTRIBUTOR</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>BSO</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>CS</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>SND</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>FINANCE</role-name>
    </security-role>
    <resource-ref>
        <res-ref-name>jdbc/chromia_auth</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>
    <display-name>bKash Struts</display-name>
    <filter>
        <filter-name>struts2</filter-name>
        <filter-class>org.apache.struts2.dispatcher.ng.filter.StrutsPrepareAndExecuteFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>struts2</filter-name>
        <url-pattern>/secure/action/*</url-pattern>
    </filter-mapping>
</web-app>
